# ── Generierte Route-Dateien ──────────────────────────────────────────────────
# Diese Dateien werden von SUMO-Tools automatisch erzeugt.
# Wie man sie neu generiert: siehe README.md → "Route-Dateien generieren"

oneJunction/routeFiles/randtrips.rou.xml
oneJunction/routeFiles/oneJunction.trips.xml
oneJunction/routeFiles/baseroutes.rou.xml
oneJunction/routeFiles/baseroutes.rou.alt.xml
oneJunction/routeFiles/merged.rou.xml

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.env
# (nicht env/ – das ist der Quellcode!)
.venv/
venv/

# ── Training-Artefakte ────────────────────────────────────────────────────────
# logs/ wird ignoriert, bis auf die kleinen Ergebnisdateien des fertigen Laufs
logs/*
logs_*/
!logs/.gitkeep
!logs/eval_results.json
!logs/training_plot.png
!logs/eval_logs/
!logs/eval_logs/evaluations.npz
!logs/best_model/

# ── Modelle & Checkpoints ─────────────────────────────────────────────────────
*.zip
*.pkl
_backup_*/
# Ausnahmen müssen nach *.zip stehen, sonst gewinnt die Ignore-Regel
!logs/best_model/best_model.zip
!logs/final_model.zip

# ── Claude Code (lokale Einstellungen) ────────────────────────────────────────
.claude/

# ── SUMO temporäre Dateien ────────────────────────────────────────────────────
*.log
tripinfo*.xml
summary*.xml

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
